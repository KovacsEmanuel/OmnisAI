{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Consolă locală de investigație, cu proveniență vizibilă și control explicit al efectelor.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.576,
          0.89,
          0.741
        ],
        "hex": "#93e3bd"
      }
    },
    "primaryInk": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.063,
          0.137,
          0.102
        ],
        "hex": "#10231a"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.686,
          0.737,
          0.792
        ],
        "hex": "#afbcca"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.055,
          0.075,
          0.094
        ],
        "hex": "#0e1318"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.082,
          0.106,
          0.133
        ],
        "hex": "#151b22"
      }
    },
    "elevated": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.114,
          0.149,
          0.188
        ],
        "hex": "#1d2630"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.929,
          0.949,
          0.969
        ],
        "hex": "#edf2f7"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.349,
          0.42,
          0.49
        ],
        "hex": "#596b7d"
      }
    },
    "divider": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.169,
          0.216,
          0.263
        ],
        "hex": "#2b3743"
      }
    },
    "selected": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.137,
          0.239,
          0.196
        ],
        "hex": "#233d32"
      }
