{
  "components": {
    "schemas": {
      "ErrorCode": {
        "enum": [
          "INVALID_HOST",
          "INVALID_ORIGIN",
          "QUERY_NOT_ALLOWED",
          "BODY_TOO_LARGE",
          "UNAUTHENTICATED",
          "CONTROL_UNAVAILABLE",
          "INVALID_CSRF",
          "CONTROL_TIMEOUT",
          "PAIRING_DENIED",
          "PAIRING_RATE_LIMITED",
          "INVALID_INPUT",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "HTTP_ERROR",
          "INTERNAL_ERROR",
          "WEB_UNAVAILABLE"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "correlation_id": {
            "format": "uuid",
            "title": "Correlation Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "correlation_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HealthReady": {
        "properties": {
          "api_ready": {
            "title": "Api Ready",
            "type": "boolean"
          },
          "assessment_ready": {
            "title": "Assessment Ready",
            "type": "boolean"
          },
          "dashboard_ready": {
            "title": "Dashboard Ready",
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReadinessReason"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "api_ready",
          "dashboard_ready",
          "assessment_ready",
          "reason"
        ],
        "title": "HealthReady",
        "type": "object"
      },
      "InstanceView": {
        "properties": {
          "admission_open": {
            "title": "Admission Open",
            "type": "boolean"
          },
          "assessment_ready": {
            "title": "Assessment Ready",
            "type": "boolean"
          },
          "dashboard_ready": {
            "title": "Dashboard Ready",
            "type": "boolean"
          },
          "generation": {
            "title": "Generation",
            "type": "integer"
          },
          "instance_id": {
            "format": "uuid",
            "title": "Instance Id",
            "type": "string"
          },
          "quiesced_generation": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quiesced Generation"
          },
          "shutdown_command_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shutdown Command Id"
          },
          "shutdown_finalized": {
            "title": "Shutdown Finalized",
            "type": "boolean"
          },
          "supervisor_epoch": {
            "title": "Supervisor Epoch",
            "type": "integer"
          },
          "supervisor_ready": {
            "title": "Supervisor Ready",
            "type": "boolean"
          }
        },
        "required": [
          "instance_id",
          "generation",
          "admission_open",
          "shutdown_command_id",
          "quiesced_generation",
          "supervisor_epoch",
          "supervisor_ready",
          "shutdown_finalized",
          "assessment_ready",
          "dashboard_ready"
        ],
        "title": "InstanceView",
        "type": "object"
      },
      "PairingBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 128,
            "minLength": 16,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "PairingBody",
        "type": "object"
      },
      "ReadinessReason": {
        "enum": [
          "DATABASE_UNAVAILABLE",
          "SCHEMA_INCOMPATIBLE"
        ],
        "title": "ReadinessReason",
        "type": "string"
      },
      "SessionView": {
        "properties": {
          "authenticated": {
            "default": true,
            "title": "Authenticated",
            "type": "boolean"
          },
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token"
        ],
        "title": "SessionView",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/instance": {
      "get": {
        "operationId": "instance_api_instance_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceView"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Forbidden"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Instance"
      }
    },
