  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist, Segoe UI, Liberation Sans, Arial, sans-serif",
        "fontSize": {
          "value": 1.75,
          "unit": "rem"
        },
        "fontWeight": 500,
        "letterSpacing": {
