{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "operations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD",
              "OPTIONS"
            ],
            "type": "string"
          },
          "path": {
            "maxLength": 240,
            "pattern": "^/[^\\\\\\s]*$",
            "type": "string"
          },
          "statuses": {
            "items": {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            "maxItems": 128,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "method",
          "path",
          "statuses"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "type": "array"
    }
  },
  "required": [
    "operations"
  ],
  "type": "object"
}
