# P0 control image: build context is the checksum-verified release bundle only.
FROM python:3.13.15-slim-bookworm@sha256:3e2de9c40ca4e3d73240059f9d48baff27908f10293e985a2f382a0378e6df4a

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMNIS_WEB_ROOT=/opt/omnis/web
WORKDIR /opt/omnis
COPY api/requirements.txt /opt/omnis/requirements.txt
RUN python -m pip install --no-cache-dir --require-hashes -r /opt/omnis/requirements.txt
COPY api/omnis_api-0.1.0-py3-none-any.whl /opt/omnis/omnis_api-0.1.0-py3-none-any.whl
RUN python -m pip install --no-deps /opt/omnis/omnis_api-0.1.0-py3-none-any.whl
COPY web/ /opt/omnis/web/
# Public UI assets must remain readable with the operator UID mapping at runtime.
RUN chmod -R a+rX /opt/omnis/web/
USER 65532:65532
CMD ["python", "-I", "-m", "uvicorn", "omnis.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8765", "--no-proxy-headers", "--no-access-log"]
